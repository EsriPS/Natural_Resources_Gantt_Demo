# Public configuration for the Plant Work Scheduler demo.
# Register an OAuth app in ArcGIS and set its redirect URI to this app's URL.

# ArcGIS org portal (El Segundo IFC scene lives in the "esripetroleum" org)
VITE_PORTAL_URL=https://esripetroleum.maps.arcgis.com
VITE_ARCGIS_OAUTH_APP_ID=pto32fRzGMpp5cqU

# Secured 3D scene service (SceneLayer sublayer 0)
VITE_SCENE_URL=https://tiles.arcgis.com/tiles/2BOLYujtFjlNg1bd/arcgis/rest/services/El_Segundo_Georeferenced_IFC/SceneServer/layers/0

# Default plant location (El Segundo, CA — NWS grid LOX/148,40).
# Overridden at runtime by the scene's fullExtent center once it loads.
VITE_PLANT_LAT=33.917
VITE_PLANT_LON=-118.416
